# ---------------------------------------------------------------------------
# The Lenny Growth Assistant — environment template
#
#   cp .env.example .env
#
# Every value below is read by backend/app/config.py. Nothing else in the
# application reads the environment, so switching model provider, retrieval
# behaviour, or safety limits is an edit to this file and a restart — never a
# code change. `make doctor` validates this file before you start.
# ---------------------------------------------------------------------------

# ---- service ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# console for humans, json for anything that ships logs somewhere
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- ports (host side; change if something already owns them) --------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
# 5433 rather than 5432 so a Postgres you already run locally keeps working.
POSTGRES_PORT=5433

# ---- database --------------------------------------------------------------
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
# Used when running the backend outside Docker. Inside Docker, compose
# overrides this to point at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5433/lenny

# ---------------------------------------------------------------------------
# MODEL PROVIDERS
#
# The assignment requires both a cloud model and a local model. Flip
# CHAT_PROVIDER between them and restart the backend; the UI badge reads the
# live value from /api/config, so whatever is serving the answer is what the
# screen says.
#
#   ollama    — local, no API key, required for the demo
#   anthropic — cloud
#   openai    — cloud
#   echo      — deterministic offline stub used by the test suite and CI
# ---------------------------------------------------------------------------
CHAT_PROVIDER=ollama

# Optional. If the primary provider errors, the turn is retried once here and
# the UI says the fallback was used. Leave blank to disable.
CHAT_FALLBACK_PROVIDER=

# ---- ollama (local) --------------------------------------------------------
# From inside Docker this must be host.docker.internal, not localhost.
# Running the backend directly on the host? Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- anthropic (cloud) -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# ---- openai (cloud) --------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- generation ------------------------------------------------------------
MAX_OUTPUT_TOKENS=4096
# Low by design: this app quotes sources, it does not improvise.
TEMPERATURE=0.2
# Local 8B models on CPU are slow. Lower this only if you are on cloud.
REQUEST_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# EMBEDDINGS
#
# EMBEDDING_DIM must match the vector column in the database. Changing the
# embedding model after ingesting means changing this number AND re-ingesting:
#
#   make resize-embeddings DIM=1536   # rewrites the column, clears the index
#   make ingest FORCE=1
#
# nomic-embed-text = 768 · text-embedding-3-small = 1536
# `hash` is a deterministic offline embedder for tests. It is not semantic.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# AGENT
#
#   native     — the in-repo tool loop; works with every provider, including
#                Ollama, so it is the default and the one the demo uses
#   claude_sdk — the Anthropic Claude Agent SDK runtime (cloud only; requires
#                `pip install claude-agent-sdk` and ANTHROPIC_API_KEY)
#
# See docs/decisions/ADR-005 for why both exist.
# ---------------------------------------------------------------------------
AGENT_RUNTIME=native
MAX_TOOL_ITERATIONS=4

# ---------------------------------------------------------------------------
# RETRIEVAL
#
# Vector and keyword results are fused with Reciprocal Rank Fusion, so there
# are no hand-tuned weights to get wrong. RRF_K dampens the top of each list;
# 60 is the value from the original paper and there is no reason to move it
# without evidence from `make eval`.
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
RRF_K=60
# The abstention gate. Below this fused score the assistant says it does not
# know instead of guessing. Raising it makes the assistant more cautious and
# will raise the over-refusal rate in `make eval`; lower it and fabrication
# risk goes up. Change this with the eval report open, not by feel.
MIN_GROUNDING_SCORE=0.018

CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
HISTORY_TURNS_IN_CONTEXT=8

# ---------------------------------------------------------------------------
# ARTIFACTS / SAFETY
#
# Generated HTML is model output, and model output is untrusted input. It is
# sanitized on the way into the database and rendered in an iframe with
# `sandbox="allow-scripts"` and no `allow-same-origin`, under a CSP that
# permits no network access at all. See docs/design.md § threat model.
#
# ALLOW_ARTIFACT_SCRIPTS=false strips inline scripts too, giving up interactive
# artifacts in exchange for a smaller blast radius.
# ---------------------------------------------------------------------------
ARTIFACT_MAX_BYTES=400000
ALLOW_ARTIFACT_SCRIPTS=true
